## Authentication Testing Rules

### Actual Auth Mechanism (Session + Cookies)

**Cookies Used:**
- `ecommerce_session` - Laravel session cookie
- `XSRF-TOKEN` - CSRF token
- `js_auth` or `auth` (legacy) - Pinia persisted auth state

**Store:** `app/stores/auth.ts`

**Plugin:** `app/plugins/01.auth.ts` (runs on every page load)

### Auth Helper Pattern

```typescript
// ✅ CORRECT - Use API login for setup (faster)
export async function loginViaAPI(page: Page, user: TestUser): Promise<void> {
  const response = await page.request.post('/api/auth/login', {
    data: {
      email: user.email,
      password: user.password,
    },
  });

  expect(response.ok()).toBeTruthy();
  
  // Verify cookies are set
  const cookies = await page.context().cookies();
  expect(cookies.some(c => c.name === 'ecommerce_session')).toBeTruthy();
}

// ✅ CORRECT - Use UI login for testing the flow itself
export async function loginViaUI(page: Page, user: TestUser): Promise<void> {
  await page.goto('/login');
  await page.locator('input[type="email"]').fill(user.email);
  await page.locator('input[type="password"]').fill(user.password);
  await page.locator('button[type="submit"]').click();
  await page.waitForURL('/'); // Actual behavior: redirects to home
}

// ✅ CORRECT - Check auth state via cookies
export async function isLoggedIn(page: Page): Promise<boolean> {
  const cookies = await page.context().cookies();
  const authCookie = cookies.find(c => c.name === 'js_auth' || c.name === 'auth');
  
  if (!authCookie) return false;
  
  try {
    const authData = JSON.parse(authCookie.value);
    return !!authData.user;
  } catch {
    return false;
  }
}
```

### Auth Test Structure

```typescript
test.describe('Authentication', () => {
  test.beforeEach(async ({ page }) => {
    // Start fresh - clear all auth state
