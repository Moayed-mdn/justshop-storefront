## Cart Testing Rules

### Actual Cart Implementation

**Guest Cart:**
- Storage: `localStorage`
- Key: `js_cart_{tenantId}` (e.g., `js_cart_demo`)
- Client-side only
- Items have local IDs: `local_12345`

**Authenticated Cart:**
- Storage: Backend database
- Synced via `/api/cart` endpoints
- Server calculates totals

**Store:** `app/stores/cart.ts`

**Plugin:** `app/plugins/02.cart.ts` (runs after auth plugin)

### Cart Helper Pattern

```typescript
// ✅ CORRECT - Get guest cart from localStorage (actual key pattern)
export async function getGuestCart(page: Page, tenantId: string = 'demo') {
  const storageKey = `js_cart_${tenantId}`;
  const cartData = await page.evaluate((key) => {
    return localStorage.getItem(key);
  }, storageKey);
  
  return cartData ? JSON.parse(cartData) : null;
}

// ✅ CORRECT - Clear guest cart
export async function clearGuestCart(page: Page, tenantId: string = 'demo'): Promise<void> {
  const storageKey = `js_cart_${tenantId}`;
  await page.evaluate((key) => {
    localStorage.removeItem(key);
  }, storageKey);
}

// ✅ CORRECT - Add to cart via UI (actual flow)
export async function addToCartViaUI(page: Page, productSlug: string): Promise<void> {
  await page.goto(`/shop/product/${productSlug}`);
  
  // Select variant if multiple exist (actual behavior)
  const variantSelector = page.locator('[data-testid="product-variant-selector"]');
  if (await variantSelector.isVisible()) {
    await variantSelector.first().click();
  }
  
  await page.click('button:has-text("Add to Cart")');
  
  // Wait for success toast (actual UX pattern)
  await expect(page.locator('text=/added to cart/i')).toBeVisible();
}

// ✅ CORRECT - Clear cart via API
export async function clearCartViaAPI(page: Page): Promise<void> {
  await page.request.delete('/api/cart/clear');
}
```

### Test Cart Merge on Login (Critical Flow)

```typescript
test('guest cart merges on login', async ({ page }) => {
  // Add items as guest
  await addToCartViaUI(page, 'product-1');
  await addToCartViaUI(page, 'product-2');
  
  // Verify guest cart
  const guestCart = await getGuestCart(page);
  expect(guestCart.items).toHaveLength(2);
  
  // Login (triggers cartStore.onLogin() - actual behavior)
  await loginViaUI(page, TEST_USERS.customer);
  
  // Cart should still have 2 items (merged)
  await page.goto('/cart');
  const itemCount = await page.locator('[data-testid="cart-item"]').count();
  expect(itemCount).toBe(2);
  
  // Guest cart should be cleared
  const clearedCart = await getGuestCart(page);
  expect(clearedCart).toBeNull();
});
```


