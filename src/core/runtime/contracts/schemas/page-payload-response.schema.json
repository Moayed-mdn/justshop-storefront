{
  "title": "RuntimePagePayloadResponse",
  "type": "object",
  "required": ["requestContext", "data", "cache"],
  "properties": {
    "requestContext": {
      "type": "object",
      "required": ["requestId", "tenantId", "tenantKey", "locale", "path", "runtimeVersion", "preview"],
      "properties": {
        "requestId": { "type": "string" },
        "tenantId": { "type": ["string", "null"] },
        "tenantKey": { "type": ["string", "null"] },
        "locale": { "type": "string", "enum": ["en", "ar"] },
        "path": { "type": "string" },
        "runtimeVersion": { "type": "string" },
        "preview": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["page"],
      "properties": {
        "page": {
          "type": "object",
          "required": ["id", "pageType", "title", "slug", "locale", "layout", "status", "sections", "seo", "publishedAt", "updatedAt"],
          "properties": {
            "id": { "type": "string" },
            "pageType": { "type": "string", "enum": ["home", "marketing_page", "category_page", "product_page"] },
            "title": { "type": "string" },
            "slug": { "type": "string" },
            "locale": { "type": "string", "enum": ["en", "ar"] },
            "layout": { "type": "string", "enum": ["default", "marketing", "catalog", "product"] },
            "status": { "type": "string", "enum": ["published", "draft"] },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "type", "component", "props", "version", "dataState"],
                "properties": {
                  "id": { "type": "string" },
                  "type": { "type": "string" },
                  "component": { "type": "string" },
                  "props": { "type": "object" },
                  "version": { "type": "string" },
                  "dataState": { "type": "string", "enum": ["ready", "empty", "error"] }
                },
                "additionalProperties": false
              }
            },
            "seo": {
              "type": "object",
              "required": ["title", "description", "canonicalUrl", "robots", "hreflang", "openGraph", "twitter", "jsonLd"],
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "canonicalUrl": { "type": "string" },
                "robots": { "type": "string", "enum": ["index,follow", "noindex,nofollow", "noindex,follow"] },
                "hreflang": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["locale", "url"],
                    "properties": {
                      "locale": { "type": "string", "enum": ["en", "ar"] },
                      "url": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                },
                "openGraph": {
                  "type": "object",
                  "required": ["title", "description", "type", "imageUrl"],
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "type": { "type": "string", "enum": ["website", "product"] },
                    "imageUrl": { "type": ["string", "null"] }
                  },
                  "additionalProperties": false
                },
                "twitter": {
                  "type": "object",
                  "required": ["card", "title", "description", "imageUrl"],
                  "properties": {
                    "card": { "type": "string", "enum": ["summary", "summary_large_image"] },
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "imageUrl": { "type": ["string", "null"] }
                  },
                  "additionalProperties": false
                },
                "jsonLd": {
                  "type": "array",
                  "items": { "type": "object" }
                }
              },
              "additionalProperties": false
            },
            "publishedAt": { "type": ["string", "null"] },
            "updatedAt": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "required": ["key", "artifact", "ttlSeconds", "tags", "bypassed"],
      "properties": {
        "key": { "type": "string" },
        "artifact": { "type": "string", "enum": ["page", "seo"] },
        "ttlSeconds": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "bypassed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
