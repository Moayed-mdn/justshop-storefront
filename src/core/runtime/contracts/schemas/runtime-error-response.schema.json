{
  "title": "RuntimeErrorResponse",
  "type": "object",
  "required": ["requestContext", "error"],
  "properties": {
    "requestContext": {
      "type": "object",
      "required": ["requestId", "tenantId", "tenantKey", "locale", "path", "runtimeVersion", "preview"],
      "properties": {
        "requestId": { "type": "string" },
        "tenantId": { "type": ["string", "null"] },
        "tenantKey": { "type": ["string", "null"] },
        "locale": { "type": "string", "enum": ["en", "ar"] },
        "path": { "type": "string" },
        "runtimeVersion": { "type": "string" },
        "preview": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "httpStatus", "retryable", "details"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "runtime.tenant_not_found",
            "runtime.tenant_inactive",
            "runtime.invalid_locale",
            "runtime.route_not_found",
            "runtime.page_not_found",
            "runtime.preview_invalid",
            "runtime.preview_expired",
            "runtime.validation_failed",
            "runtime.internal_error"
          ]
        },
        "message": { "type": "string" },
        "httpStatus": { "type": "integer", "enum": [400, 401, 403, 404, 409, 422, 500, 503] },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
