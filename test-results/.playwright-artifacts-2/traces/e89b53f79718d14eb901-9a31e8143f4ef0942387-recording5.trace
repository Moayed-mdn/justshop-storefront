\n    height: 90%;\n    margin-top: 5%;\n  }\n}\n@keyframes marquee {\n  0% {\n    transform: translateZ(0);\n  }\n  to {\n    transform: translate3d(calc(-100% - var(--gap)),0,0);\n  }\n}\n@keyframes marquee-rtl {\n  0% {\n    transform: translateZ(0);\n  }\n  to {\n    transform: translate3d(calc(100% + var(--gap)),0,0);\n  }\n}\n@keyframes marquee-vertical {\n  0% {\n    transform: translateZ(0);\n  }\n  to {\n    transform: translate3d(0,calc(-100% - var(--gap)),0);\n  }\n}\n@keyframes marquee-vertical-rtl {\n  0% {\n    transform: translate3d(0,calc(-100% - var(--gap)),0);\n  }\n  to {\n    transform: translate3d(0,calc(-100%*var(--gap)),0);\n  }\n}\n@layer theme {\n  :host,:root {\n    --ui-header-height: calc(var(--spacing) * 16);\n  }\n  .light,:host,:root {\n    --ui-text-dimmed: var(--ui-color-neutral-400);\n    --ui-text-muted: var(--ui-color-neutral-500);\n    --ui-text-toned: var(--ui-color-neutral-600);\n    --ui-text: var(--ui-color-neutral-700);\n    --ui-text-highlighted: var(--ui-color-neutral-900);\n    --ui-text-inverted: #fff;\n    --ui-bg: #fff;\n    --ui-bg-muted: var(--ui-color-neutral-50);\n    --ui-bg-elevated: var(--ui-color-neutral-100);\n    --ui-bg-accented: var(--ui-color-neutral-200);\n    --ui-bg-inverted: var(--ui-color-neutral-900);\n    --ui-border: var(--ui-color-neutral-200);\n    --ui-border-muted: var(--ui-color-neutral-200);\n    --ui-border-accented: var(--ui-color-neutral-300);\n    --ui-border-inverted: var(--ui-color-neutral-900);\n    --ui-radius: 0.25rem;\n    --ui-container: 80rem;\n  }\n  .dark {\n    --ui-text-dimmed: var(--ui-color-neutral-500);\n    --ui-text-muted: var(--ui-color-neutral-400);\n    --ui-text-toned: var(--ui-color-neutral-300);\n    --ui-text: var(--ui-color-neutral-200);\n    --ui-text-highlighted: #fff;\n    --ui-text-inverted: var(--ui-color-neutral-900);\n    --ui-bg: var(--ui-color-neutral-900);\n    --ui-bg-muted: var(--ui-color-neutral-800);\n    --ui-bg-elevated: var(--ui-color-neutral-800);\n    --ui-bg-accented: var(--ui-color-neutral-700);\n    --ui-bg-inverted: #fff;\n    --ui-border: var(--ui-color-neutral-800);\n    --ui-border-muted: var(--ui-color-neutral-700);\n    --ui-border-accented: var(--ui-color-neutral-700);\n    --ui-border-inverted: #fff;\n  }\n}\n:root {\n  --green-900: #003D29;\n  --green-950: #00251C;\n  --orange-500: #FF7006;\n  --orange-300: #FFB23C;\n  --pink-500: #C34482;\n  --blue-100: #DBEAFE;\n  --blue-800: #1E40AF;\n  --green-100: #D1FAE5;\n  --green-800: #065F46;\n  --amber-100: #FEF3C7;\n  --amber-800: #92400E;\n  --gray-900: #231F1E;\n  --gray-700: #333333;\n  --gray-400: #D3D2D2;\n  --gray-300: #E5E7EB;\n  --gray-200: #F5F6F6;\n  --gray-100: #F3F4F6;\n  --white: #FFFFFF;\n  --black: #000000;\n  --black-40: rgba(0, 0, 0, 0.4);\n  --black-10: rgba(0, 0, 0, 0.1);\n  --black-15: rgba(0, 0, 0, 0.15);\n  --transparent: transparent;\n  --green-success: #2e7d32;\n  --red-error: #EF4444;\n  --color-primary: var(--green-900);\n  --color-accent: var(--orange-500);\n  --color-accent-hover: var(--orange-300);\n  --color-bg-page: var(--white);\n  --color-bg-surface: var(--gray-100);\n  --color-bg-card: var(--gray-200);\n  --color-bg-elevated: var(--white);\n  --color-text-primary: var(--gray-900);\n  --color-text-secondary: var(--gray-700);\n  --color-text-muted: var(--gray-400);\n  --color-text-inverse: var(--white);\n  --color-text-black: var(--black);\n  --color-border-default: var(--gray-300);\n  --color-border-strong: var(--gray-400);\n  --color-border-active: var(--color-primary);\n  --color-error: var(--red-error);\n  --color-success: var(--green-success);\n  --color-warning: #f59e0b;\n  --color-info: #3b82f6;\n  --color-overlay-light: rgba(0, 0, 0, 0.1);\n  --color-overlay-medium: rgba(0, 0, 0, 0.4);\n  --color-bg-disabled: var(--gray-200);\n  --color-text-disabled: var(--gray-400);\n  --color-border-disabled: var(--gray-300);\n  --color-bg-strong: var(--gray-900);\n  --color-bg-inverse: var(--gray-900);\n  --color-border-inverse: var(--gray-700);\n  --color-focus-ring: var(--color-primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    --color-focus-ring: color-mix(in srgb, var(--color-primary) 40%, transparent);\n  }\n  --color-bg-hover: var(--gray-200);\n  --color-border-hover: var(--color-border-default);\n  @supports (color: color-mix(in lab, red, red)) {\n    --color-border-hover: color-mix(in srgb, var(--color-border-default) 150%, black);\n  }\n  --color-border-subtle: var(--color-text-primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    --color-border-subtle: color-mix(in srgb, var(--color-text-primary) 10%, transparent);\n  }\n  --color-surface: var(--color-bg-elevated);\n  --color-surface-hover: var(--color-bg-elevated);\n  @supports (color: color-mix(in lab, red, red)) {\n    --color-surface-hover: color-mix(in srgb, var(--color-bg-elevated) 95%, black);\n  }\n  --color-error-bg: #FEE2E2;\n  --color-error-hover: #DC2626;\n  --color-info-bg: #DBEAFE;\n  --color-info-text: #1E40AF;\n  --color-info-border: #93C5FD;\n  --color-warning-bg: #FEF3C7;\n  --color-warning-text: #92400E;\n  --status-pending-bg: #FEF3C7;\n  --status-pending-text: #92400E;\n  --status-processing-bg: #DBEAFE;\n  --status-processing-text: #1E40AF;\n  --status-shipped-bg: #E0E7FF;\n  --status-shipped-text: #4C1D95;\n  --status-delivered-bg: #D1FAE5;\n  --status-delivered-text: #065F46;\n  --status-cancelled-bg: #FEE2E2;\n  --status-cancelled-text: #991B1B;\n  --status-refunded-bg: #FFEDD5;\n  --status-refunded-text: #7C2D12;\n  --color-overlay-heavy: rgba(0, 0, 0, 0.7);\n  --color-overlay-backdrop: rgba(0, 0, 0, 0.4);\n  --color-on-overlay: #FFFFFF;\n}\n:root:not([data-merchant-dark-theme])[data-theme=\"dark\"] {\n  --color-primary: #00A670;\n  --color-bg-page: #0b0b0b;\n  --color-bg-surface: #121212;\n  --color-bg-card: #1a1a1a;\n  --color-bg-elevated: #222222;\n  --color-bg-hover: #2a2a2a;\n  --color-bg-strong: var(--white);\n  --color-bg-disabled: #222222;\n  --color-text-primar