# Server-side runtime configuration (never exposed to client)
NUXT_API_BASE=http://localhost:8000/api/v1

# Storefront runtime rollout controls. Keep production default at full unless
# you are intentionally narrowing the rollout in staging or local verification.
STOREFRONT_RUNTIME_ROLLOUT_MODE=full
STOREFRONT_RUNTIME_KILL_SWITCH=false
STOREFRONT_RUNTIME_INTERNAL_TENANT_KEYS=justshop-demo,demo.justshop.test
STOREFRONT_RUNTIME_PILOT_TENANT_KEYS=

# Optional Nuxt server overrides for SSR/runtimeConfig verification.
NUXT_STOREFRONT_RUNTIME_ROLLOUT_MODE=full
NUXT_STOREFRONT_RUNTIME_KILL_SWITCH=false
NUXT_STOREFRONT_RUNTIME_INTERNAL_TENANT_KEYS=justshop-demo,demo.justshop.test
NUXT_STOREFRONT_RUNTIME_PILOT_TENANT_KEYS=

# Public runtime configuration used by the current codebase.
# Replace these placeholders with environment-specific values.

NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# URL for the merchant dashboard (used in "Create your store" CTA on error pages)
NUXT_PUBLIC_DASHBOARD_URL=http://localhost:4000
